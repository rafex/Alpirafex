# Stable Alpine base used by the first Alpirafex release.
ALPINE_BRANCH="v3.24"
ALPINE_RELEASE="3.24.2"
ALPINE_APORTS_URL="https://gitlab.alpinelinux.org/alpine/aports.git"
ALPINE_APORTS_REF="d9d560d5de74ff9a7a73f3c903d6f126a0bf3142"

# Alpirafex metadata.
ALPIRAFEX_VERSION="0.1.0"
ALPIRAFEX_ARCHES="x86_64 aarch64"

# Set this for a release build. It is intentionally empty for local builds.
# Example: https://packages.example.org/alpirafex/v3.24
ALPIRAFEX_REPO_BASE_URL=""

ALPIRAFEX_BUILD_DIR="build"
ALPIRAFEX_DIST_DIR="dist"
